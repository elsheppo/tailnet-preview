#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NODE_BIN="${TAILNET_PREVIEW_NODE_BIN:-$(command -v node || true)}"

if [[ -z "$NODE_BIN" || ! -x "$NODE_BIN" ]]; then
  printf 'Tailnet Preview: node was not found in PATH.\n' >&2
  exit 1
fi

exec "$NODE_BIN" "$SCRIPT_DIR/preview.mjs" "$@"
